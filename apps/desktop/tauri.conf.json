{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "2.0.1",
  "identifier": "dev.nexus.localclient",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title":"Nexus","width":380,"height":620,"resizable":false,"maximizable":false,"decorations":false,"shadow":true}],
    "security": {
      "capabilities": [{"identifier":"desktop-main","windows":["main"],"permissions":["control-core","core:window:allow-start-dragging","core:window:allow-minimize","core:window:allow-close"]}],
      "csp":"default-src 'none'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'"}
  },
  "plugins": {"updater":{
    "endpoints":["https://github.com/shejiang000-prog/Nexus/releases/latest/download/latest.json"],
    "pubkey":"dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQTA3MEE2NzVBQUQ3NDgKUldSSTE2cDFwbkNneWhtd0VCUXJIZ1JXMlJIYnlEdVVlOXV4T0cvTllNTDdMZUIydHVtV0xmaEgK",
    "requireSignedVersion":true,"windows":{"installMode":"passive"}
  }},
  "bundle": {"active":true,"targets":["nsis"],"icon":["icons/icon.ico"],"useLocalToolsDir":true,
    "windows":{"webviewInstallMode":{"type":"embedBootstrapper"},"nsis":{
      "installMode":"perMachine","template":"installer/setup.nsi"
    }}
  }
}
