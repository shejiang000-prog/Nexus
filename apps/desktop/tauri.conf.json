{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "0.1.0",
  "identifier": "dev.nexus.localclient",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title":"Nexus","width":1080,"height":720,"minWidth":420,"minHeight":440}],
    "security": {
      "capabilities": [{"identifier":"desktop-main","windows":["main"],"permissions":["control-core"]}],
      "csp":"default-src 'none'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'"}
  },
  "bundle": {"active":false,"icon":["icons/icon.ico"]}
}
