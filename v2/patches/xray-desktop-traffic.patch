+func desktopInbound(ctx context.Context) bool {
+	in := session.InboundFromContext(ctx)
+	return DesktopTraffic.Enabled && in != nil && (in.Tag == "socks" || in.Tag == "http" || in.Tag == "packet-tun")
+}
