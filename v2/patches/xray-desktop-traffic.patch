+// nexus-core has one desktop session per process. Meter only the payload links
+// of its three application inbounds, after local SOCKS/CONNECT negotiation.
+var DesktopTraffic struct {
+	Enabled          bool
+	Uplink, Downlink appstats.Counter
+}
