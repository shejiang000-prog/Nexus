 // Time when the next keep-alive packet should be sent.
 // It returns a zero time if no keep-alive should be sent.
+// NexusKeepTunnelAlive uses the existing connection timer for an accepted CONNECT.
+// Closing the request or learning the peer's final size ends its keepalive. A local
+// write-side FIN still allows the tunnel to receive data.
+func (c *Conn) NexusKeepTunnelAlive(ctx context.Context, stream *Stream) {
+	if c.nexusTunnels.Add(1) == 1 {
+		c.scheduleSending()
+	}
+	lifetime, finish := context.WithCancel(ctx)
+	stopConn := context.AfterFunc(c.Context(), finish)
+	context.AfterFunc(lifetime, func() {
+		stopConn()
+		if c.nexusTunnels.Add(-1) == 0 {
+			c.scheduleSending()
+		}
+	})
+	stream.SetReceiveFinalSizeCallback(func(int64) { finish() })
+}
