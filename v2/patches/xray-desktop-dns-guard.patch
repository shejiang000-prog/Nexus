@@ -0,0 +1,66 @@
+package tun
+
+import (
+	"errors"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestDesktopDNSBlockScope(t *testing.T) {
+	for _, encrypted := range []bool{false, true} {
+		count := 0
+		err := desktopDNSBlocks(17, new(fwpByteBlob), encrypted, func(layer *windows.GUID, cs []fwpmFilterCondition0) error {
+			if *layer != fwpmLayerALEAuthConnectV4 && *layer != fwpmLayerALEAuthConnectV6 {
+				t.Fatal("unexpected layer")
+			}
+			fields := map[windows.GUID]fwpmFilterCondition0{}
+			for _, c := range cs {
+				if _, ok := fields[c.fieldKey]; ok {
+					t.Fatal("ambiguous AND/OR condition")
+				}
+				fields[c.fieldKey] = c
+			}
+			if _, local := fields[fwpmConditionIPLocalInterface]; !local {
+				if _, hop := fields[fwpmConditionIPNexthopInterface]; !hop {
+					t.Fatal("unscoped interface")
+				}
+			}
+			p := fields[fwpmConditionIPProtocol].conditionValue.value
+			if p != windows.IPPROTO_TCP && p != windows.IPPROTO_UDP {
+				t.Fatal("unscoped protocol")
+			}
+			if _, service := fields[fwpmConditionALEUserID]; service {
+				if !encrypted {
+					t.Fatal("unexpected service block")
+				}
+				if p == windows.IPPROTO_UDP {
+					port := fields[fwpmConditionIPRemotePort]
+					if port.conditionValue.value < 5353 || port.conditionValue.value > 5355 {
+						t.Fatal("unscoped discovery")
+					}
+					if port.matchType == fwpMatchEqual && port.conditionValue.value != 5354 && fields[fwpmConditionIPRemoteAddress].matchType != 10 {
+						t.Fatal("missing multicast exception")
+					}
+				}
+			} else {
+				if _, core := fields[fwpmConditionALEAppID]; !core || fields[fwpmConditionIPRemotePort].conditionValue.value != 53 {
+					t.Fatal("unscoped port 53 block")
+				}
+			}
+			count++
+			return nil
+		})
+		want := 32
+		if encrypted {
+			want = 80
+		}
+		if err != nil || count != want {
+			t.Fatalf("installed %d/%d: %v", count, want, err)
+		}
+	}
+	failed := errors.New("cannot add filter")
+	if err := desktopDNSBlocks(17, new(fwpByteBlob), true, func(*windows.GUID, []fwpmFilterCondition0) error { return failed }); err != failed {
+		t.Fatal("ignored failed installation")
+	}
+}
