[Unit]
Description=Nexus V2 node
After=network-online.target

[Service]
User=nexus
Group=nexus
Environment=GODEBUG=http2xconnect=1
ExecStart=/usr/local/bin/nexus-node run --config /etc/nexus/v2.json
StateDirectory=nexus
WorkingDirectory=/var/lib/nexus
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
